/* Ex 24 - LEX Program to Count Comments and Eliminate Them */

%{
#include <stdio.h>
int comment_count = 0;
%}

%%
"//".*                  { comment_count++; }
"/*"([^*]|\*+[^/*])*"*/" { comment_count++; }
.|\n                    { printf("%s", yytext); }
%%

int yywrap() { return 1; }
int main() {
    yylex();
    fprintf(stderr, "\nTotal comment lines eliminated: %d\n", comment_count);
    return 0;
}

