/* Ex 20 - LEX Program to Count Macros and Header Files */

%{
#include <stdio.h>
int macros = 0, headers = 0;
%}

%%
"#define"[^\n]*   { macros++; }
"#include"[^\n]*  { headers++; }
.|\n              ;
%%

int yywrap() { return 1; }
int main() {
    yylex();
    printf("Macros defined: %d\nHeader files included: %d\n", macros, headers);
    return 0;
}

