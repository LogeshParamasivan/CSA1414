/* Ex 23 - LEX Program to Add Line Numbers to C File */

%{
#include <stdio.h>
int lineno = 1;
%}

%%
^.*   { printf("%d: %s", lineno++, yytext); }
\n    { printf("\n"); }
%%

int yywrap() { return 1; }
int main() {
    yylex();
    return 0;
}

